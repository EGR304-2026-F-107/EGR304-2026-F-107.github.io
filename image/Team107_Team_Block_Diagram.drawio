="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=7;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2070" y="600" width="60" height="22" as="geometry"/></mxCell><mxCell id="n211" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2130" y="580" width="60" height="20" as="geometry"/></mxCell><mxCell id="n212" value="OBJ_HELD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=7;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2130" y="600" width="60" height="22" as="geometry"/></mxCell><mxCell id="n213" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2190" y="580" width="60" height="20" as="geometry"/></mxCell><mxCell id="n214" value="ARM_IN_POS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=7;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2190" y="600" width="60" height="22" as="geometry"/></mxCell><mxCell id="n215" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2250" y="580" width="60" height="20" as="geometry"/></mxCell><mxCell id="n216" value="SPEED_SET" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=7;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2250" y="600" width="60" height="22" as="geometry"/></mxCell><mxCell id="n217" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2310" y="580" width="60" height="20" as="geometry"/></mxCell><mxCell id="n218" value="GRIP_FORCE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=7;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2310" y="600" width="60" height="22" as="geometry"/></mxCell><mxCell id="n219" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2370" y="580" width="60" height="20" as="geometry"/></mxCell><mxCell id="n220" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=7;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2370" y="600" width="60" height="22" as="geometry"/></mxCell><mxCell id="n221" value="Digital" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="1950" y="622" width="300" height="20" as="geometry"/></mxCell><mxCell id="n222" value="Analog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2250" y="622" width="120" height="20" as="geometry"/></mxCell><mxCell id="n223" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="2370" y="622" width="60" height="20" as="geometry"/></mxCell><mxCell id="n224" value="&lt;b&gt;Connector 1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=8;align=center;verticalAlign=middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="1950" y="642" width="480" height="20" as="geometry"/></mxCell><mxCell id="n225" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="662" as="sourcePoint"/><mxPoint x="940.0" y="662" as="targetPoint"/><Array as="points"><mxPoint x="320.0" y="740"/><mxPoint x="940.0" y="740"/></Array></mxGeometry></mxCell><mxCell id="n226" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480.0" y="662" as="sourcePoint"/><mxPoint x="2190.0" y="662" as="targetPoint"/><Array as="points"><mxPoint x="1480.0" y="740"/><mxPoint x="2190.0" y="740"/></Array></mxGeometry></mxCell><mxCell id="n227" value="8-pin ribbon cable" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=8;spacing=0;" vertex="1" parent="1"><mxGeometry x="320.0" y="742" width="620.0" height="16" as="geometry"/></mxCell><mxCell id="n228" value="8-pin ribbon cable" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=8;spacing=0;" vertex="1" parent="1"><mxGeometry x="1480.0" y="742" width="710.0" height="16" as="geometry"/></mxCell><mxCell id="n229" value="Notes: 8-pin ribbon, daisy chain Arm - Gripper - User. Pins 1-5 digital, 6-7 analog (0-3.3 V), pin 8 = GND on every board. Each signal has exactly one driver; pins a board does not use are left open (gray).&lt;br&gt;Drivers: SAFE_OK, RUN_REQ, SPEED_SET = User | GRIP_CMD, ARM_IN_POS = Arm | OBJ_HELD, GRIP_FORCE = Gripper. Receiving boards put 10 kOhm pull-downs on their digital inputs, so an unplugged cable reads 0 (stop).&lt;br&gt;Changes vs. previous version: Arm uses FAN8100N + 6 V motor (position sensor removed); Gripper and User parts follow each member&amp;#x27;s latest datasheet; power added per review feedback.&lt;br&gt;Power: supply wiring is drawn only from each source to its regulators; the rail each block runs from is written in bold inside the block. Every Curiosity Nano stays at its factory 3.3 V, so all ribbon logic is 0 / 3.3 V; all grounds are common through ribbon pin 8.&lt;br&gt;Team decisions: Gripper FSR 402 + MCP6004 run from the Nano&amp;#x27;s 3.3 V so the RA0 ADC input never exceeds 3.3 V; Gripper servo PWM on RB3 and pushbutton on RB2 (RF3 is the Nano&amp;#x27;s LED0); GRIP_CMD is driven only by the Arm board (User RD2 stays an unused input). Avoid Nano on-board pins RB4 (SW0), RF3 (LED0), RF0 / RF1 (debugger UART)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="2560" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
